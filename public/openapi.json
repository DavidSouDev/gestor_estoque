{
  "openapi": "3.0.3",
  "info": {
    "title": "Gestor de Estoque API",
    "description": "API REST para gestão de empresas, usuários, produtos, combos, promoções e movimentações de estoque.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Ambiente local" }
  ],
  "tags": [
    { "name": "Empresas" },
    { "name": "Usuários" },
    { "name": "Produtos" },
    { "name": "Combos" },
    { "name": "Promoções" },
    { "name": "Movimentações" }
  ],
  "paths": {
    "/api/empresas": {
      "get": {
        "tags": ["Empresas"],
        "summary": "Listar empresas",
        "responses": {
          "200": {
            "description": "Lista de empresas",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Empresa" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Empresas"],
        "summary": "Criar empresa",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmpresaCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Empresa criada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Empresa" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/empresas/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Empresas"],
        "summary": "Buscar empresa por ID",
        "responses": {
          "200": {
            "description": "Empresa encontrada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Empresa" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Empresas"],
        "summary": "Atualizar empresa",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmpresaUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Empresa atualizada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Empresa" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Empresas"],
        "summary": "Remover empresa (soft delete)",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/usuarios": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Listar usuários",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Usuario" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Usuários"],
        "summary": "Criar usuário",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Usuário criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/usuarios/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Usuários"],
        "summary": "Buscar usuário por ID",
        "responses": {
          "200": {
            "description": "Usuário encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Usuários"],
        "summary": "Atualizar usuário",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Usuários"],
        "summary": "Remover usuário (inativa)",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/produtos": {
      "get": {
        "tags": ["Produtos"],
        "summary": "Listar produtos",
        "responses": {
          "200": {
            "description": "Lista de produtos",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Produto" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Produtos"],
        "summary": "Criar produto",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProdutoCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Produto criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Produto" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/produtos/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Produtos"],
        "summary": "Buscar produto por ID",
        "responses": {
          "200": {
            "description": "Produto encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Produto" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Produtos"],
        "summary": "Atualizar produto",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProdutoUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Produto atualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Produto" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Produtos"],
        "summary": "Remover produto (soft delete)",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/combos": {
      "get": {
        "tags": ["Combos"],
        "summary": "Listar combos",
        "responses": {
          "200": {
            "description": "Lista de combos",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Combo" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Combos"],
        "summary": "Criar combo",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComboCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Combo criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Combo" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/combos/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Combos"],
        "summary": "Buscar combo por ID",
        "responses": {
          "200": {
            "description": "Combo encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Combo" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Combos"],
        "summary": "Atualizar combo",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComboUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Combo atualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Combo" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Combos"],
        "summary": "Remover combo (soft delete)",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/promocoes": {
      "get": {
        "tags": ["Promoções"],
        "summary": "Listar promoções",
        "responses": {
          "200": {
            "description": "Lista de promoções",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Promocao" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Promoções"],
        "summary": "Criar promoção",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PromocaoCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Promoção criada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promocao" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/promocoes/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Promoções"],
        "summary": "Buscar promoção por ID",
        "responses": {
          "200": {
            "description": "Promoção encontrada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promocao" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Promoções"],
        "summary": "Atualizar promoção",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PromocaoUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Promoção atualizada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Promocao" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Promoções"],
        "summary": "Remover promoção",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/movimentacoes": {
      "get": {
        "tags": ["Movimentações"],
        "summary": "Listar movimentações",
        "responses": {
          "200": {
            "description": "Lista de movimentações",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MovimentacaoEstoque" } } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Movimentações"],
        "summary": "Registrar movimentação (ajusta o estoque do produto)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MovimentacaoCreate" } } }
        },
        "responses": {
          "201": {
            "description": "Movimentação registrada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MovimentacaoEstoque" } } }
          },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/movimentacoes/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Movimentações"],
        "summary": "Buscar movimentação por ID",
        "responses": {
          "200": {
            "description": "Movimentação encontrada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MovimentacaoEstoque" } } }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Movimentações"],
        "summary": "Remover movimentação",
        "responses": {
          "200": { "$ref": "#/components/responses/Message" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "Message": {
        "description": "Mensagem de confirmação",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } }
      },
      "Error": {
        "description": "Erro",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "properties": { "message": { "type": "string" } }
      },
      "Empresa": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "slug": { "type": "string" },
          "logo": { "type": "string", "nullable": true },
          "banner": { "type": "string", "nullable": true },
          "descricao": { "type": "string", "nullable": true },
          "telefone": { "type": "string", "nullable": true },
          "instagram": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "EmpresaCreate": {
        "type": "object",
        "required": ["nome", "slug"],
        "properties": {
          "nome": { "type": "string" },
          "slug": { "type": "string" },
          "logo": { "type": "string" },
          "banner": { "type": "string" },
          "descricao": { "type": "string" },
          "telefone": { "type": "string" },
          "instagram": { "type": "string" }
        }
      },
      "EmpresaUpdate": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "slug": { "type": "string" },
          "logo": { "type": "string" },
          "banner": { "type": "string" },
          "descricao": { "type": "string" },
          "telefone": { "type": "string" },
          "instagram": { "type": "string" }
        }
      },
      "EmpresaResumo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "slug": { "type": "string" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "senhaHash": { "type": "string", "description": "Hash bcrypt da senha, retornado pela API tal como armazenado." },
          "role": { "type": "string", "enum": ["ADMIN"] },
          "ativo": { "type": "boolean" },
          "empresaId": { "type": "string", "format": "uuid" },
          "empresa": { "$ref": "#/components/schemas/EmpresaResumo" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "UsuarioCreate": {
        "type": "object",
        "required": ["nome", "email", "senha", "empresaId"],
        "properties": {
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "senha": { "type": "string", "format": "password" },
          "empresaId": { "type": "string", "format": "uuid" }
        }
      },
      "UsuarioUpdate": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "senha": { "type": "string", "format": "password" },
          "ativo": { "type": "boolean" }
        }
      },
      "ProdutoImagem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "produtoId": { "type": "string", "format": "uuid" },
          "url": { "type": "string" },
          "alt": { "type": "string", "nullable": true },
          "ordem": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "empresaId": { "type": "string", "format": "uuid" },
          "codigo": { "type": "string" },
          "nome": { "type": "string" },
          "descricao": { "type": "string", "nullable": true },
          "precoVarejo": { "type": "number", "format": "double" },
          "precoAtacado": { "type": "number", "format": "double" },
          "estoque": { "type": "integer" },
          "fotoCapa": { "type": "string", "nullable": true },
          "ordemCatalogo": { "type": "integer" },
          "destaque": { "type": "boolean" },
          "visivelCatalogo": { "type": "boolean" },
          "ativo": { "type": "boolean" },
          "imagens": { "type": "array", "items": { "$ref": "#/components/schemas/ProdutoImagem" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ProdutoCreate": {
        "type": "object",
        "required": ["empresaId", "codigo", "nome", "precoVarejo", "precoAtacado"],
        "properties": {
          "empresaId": { "type": "string", "format": "uuid" },
          "codigo": { "type": "string" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "precoVarejo": { "type": "number", "format": "double" },
          "precoAtacado": { "type": "number", "format": "double" },
          "estoque": { "type": "integer", "default": 0 },
          "fotoCapa": { "type": "string" },
          "ordemCatalogo": { "type": "integer", "default": 0 },
          "destaque": { "type": "boolean", "default": false },
          "ativo": { "type": "boolean", "default": true },
          "visivelCatalogo": { "type": "boolean", "default": true }
        }
      },
      "ProdutoUpdate": {
        "type": "object",
        "properties": {
          "codigo": { "type": "string" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "precoVarejo": { "type": "number", "format": "double" },
          "precoAtacado": { "type": "number", "format": "double" },
          "estoque": { "type": "integer" },
          "fotoCapa": { "type": "string" },
          "ordemCatalogo": { "type": "integer" },
          "destaque": { "type": "boolean" },
          "ativo": { "type": "boolean" },
          "visivelCatalogo": { "type": "boolean" }
        }
      },
      "ComboItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "comboId": { "type": "string", "format": "uuid" },
          "produtoId": { "type": "string", "format": "uuid" },
          "quantidade": { "type": "integer" },
          "produto": { "$ref": "#/components/schemas/Produto" }
        }
      },
      "Combo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "empresaId": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "descricao": { "type": "string", "nullable": true },
          "preco": { "type": "number", "format": "double" },
          "fotoCapa": { "type": "string", "nullable": true },
          "ordemCatalogo": { "type": "integer" },
          "destaque": { "type": "boolean" },
          "visivel": { "type": "boolean" },
          "ativo": { "type": "boolean" },
          "itens": { "type": "array", "items": { "$ref": "#/components/schemas/ComboItem" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ComboCreate": {
        "type": "object",
        "required": ["empresaId", "nome", "preco"],
        "properties": {
          "empresaId": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "preco": { "type": "number", "format": "double" },
          "fotoCapa": { "type": "string" },
          "ordemCatalogo": { "type": "integer", "default": 0 },
          "destaque": { "type": "boolean", "default": false },
          "ativo": { "type": "boolean", "default": true },
          "visivel": { "type": "boolean", "default": true }
        }
      },
      "ComboUpdate": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "preco": { "type": "number", "format": "double" },
          "fotoCapa": { "type": "string" },
          "ordemCatalogo": { "type": "integer" },
          "destaque": { "type": "boolean" },
          "ativo": { "type": "boolean" },
          "visivel": { "type": "boolean" }
        }
      },
      "PromocaoItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "promocaoId": { "type": "string", "format": "uuid" },
          "produtoId": { "type": "string", "format": "uuid", "nullable": true },
          "comboId": { "type": "string", "format": "uuid", "nullable": true },
          "preco": { "type": "number", "format": "double" },
          "produto": { "$ref": "#/components/schemas/Produto" },
          "combo": { "$ref": "#/components/schemas/Combo" }
        }
      },
      "Promocao": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "empresaId": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" },
          "itens": { "type": "array", "items": { "$ref": "#/components/schemas/PromocaoItem" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PromocaoItemInput": {
        "type": "object",
        "required": ["preco"],
        "description": "Informe produtoId OU comboId.",
        "properties": {
          "produtoId": { "type": "string", "format": "uuid" },
          "comboId": { "type": "string", "format": "uuid" },
          "preco": { "type": "number", "format": "double" }
        }
      },
      "PromocaoCreate": {
        "type": "object",
        "required": ["empresaId", "nome", "dataInicio", "dataFim", "itens"],
        "properties": {
          "empresaId": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" },
          "itens": { "type": "array", "items": { "$ref": "#/components/schemas/PromocaoItemInput" } }
        }
      },
      "PromocaoUpdate": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" }
        }
      },
      "UsuarioResumo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "MovimentacaoEstoque": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "produtoId": { "type": "string", "format": "uuid" },
          "usuarioId": { "type": "string", "format": "uuid" },
          "tipo": { "type": "string", "enum": ["ENTRADA", "SAIDA", "AJUSTE"] },
          "quantidade": { "type": "integer" },
          "motivo": { "type": "string", "nullable": true },
          "produto": { "$ref": "#/components/schemas/Produto" },
          "usuario": { "$ref": "#/components/schemas/UsuarioResumo" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MovimentacaoCreate": {
        "type": "object",
        "required": ["produtoId", "usuarioId", "tipo", "quantidade"],
        "properties": {
          "produtoId": { "type": "string", "format": "uuid" },
          "usuarioId": { "type": "string", "format": "uuid" },
          "tipo": {
            "type": "string",
            "enum": ["ENTRADA", "SAIDA", "AJUSTE"],
            "description": "ENTRADA soma, SAIDA subtrai (erro se ficar negativo), AJUSTE define o estoque exatamente."
          },
          "quantidade": { "type": "integer" },
          "motivo": { "type": "string" }
        }
      }
    }
  }
}
