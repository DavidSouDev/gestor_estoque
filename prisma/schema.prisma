generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ModoInterface {
  COMPLETO
  SIMPLES
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum StatusAcesso {
  TRIAL
  EM_DIA
  CARENCIA
  BLOQUEADO
  CANCELADO
  VITALICIO
}

// D-14: apenas os valores que existem HOJE. Novas causas entram por migration
// propria na fase em que passarem a existir.
enum CausaTransicaoAcesso {
  REGISTRO
  BACKFILL
  AVALIACAO_SESSAO
}

model Empresa {
  id          String   @id @default(uuid())

  nome        String
  slug        String   @unique

  logo        String?
  banner      String?
  descricao   String?

  telefone    String?
  instagram   String?

  primaryColor String  @default("#18181b")
  accentColor  String  @default("#f59e0b")

  modoInterface ModoInterface @default(COMPLETO)

  // Fatos de billing (BILL-01). Fonte da verdade do acesso. Instantes UTC ja
  // normalizados para a meia-noite de America/Sao_Paulo (D-01).
  acessoAte       DateTime?
  trialFim        DateTime?
  canceladoEm     DateTime?
  acessoVitalicio Boolean   @default(false)

  // Bookkeeping de auditoria (D-16). NAO e fonte da verdade e NENHUMA decisao
  // de acesso pode le-lo: quem decide e sempre avaliarAcesso() sobre os 4 fatos
  // acima. Existe so para detectar transicao sem uma segunda query por request.
  ultimoStatusAuditado StatusAcesso?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  usuarios    Usuario[]
  produtos    Produto[]
  combos      Combo[]
  promocoes   Promocao[]
  auditoriasAcesso AuditoriaAcesso[]

  @@index([slug])
}

model Usuario {
  id             String   @id @default(uuid())

  nome           String
  email          String   @unique
  senhaHash      String

  role           UserRole @default(ADMIN)
  ativo          Boolean  @default(true)

  empresaId      String
  empresa        Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  movimentacoes  MovimentacaoEstoque[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empresaId])
}

model Produto {
  id                String   @id @default(uuid())

  empresaId         String
  empresa           Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  codigo            String

  nome              String
  descricao         String?

  categoria         String @default("Geral")

  precoVarejo       Decimal @db.Decimal(10,2)
  precoAtacado      Decimal @db.Decimal(10,2)

  estoque           Int @default(0)

  fotoCapa          String?

  ordemCatalogo     Int @default(0)

  destaque          Boolean @default(false)

  visivelCatalogo   Boolean @default(true)
  ativo             Boolean @default(true)

  imagens           ProdutoImagem[]
  comboItens        ComboItem[]
  promocoes         PromocaoItem[]
  movimentacoes     MovimentacaoEstoque[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([empresaId, codigo])
  @@index([empresaId, ativo, visivelCatalogo, ordemCatalogo])
}

model ProdutoImagem {
  id         String @id @default(uuid())

  produtoId  String
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  url        String
  alt        String?

  ordem      Int @default(0)

  createdAt  DateTime @default(now())

  @@index([produtoId])
}

model Combo {
  id              String @id @default(uuid())

  empresaId       String
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome            String
  descricao       String?

  preco           Decimal @db.Decimal(10,2)

  fotoCapa        String?

  ordemCatalogo   Int @default(0)

  destaque        Boolean @default(false)

  visivel         Boolean @default(true)
  ativo           Boolean @default(true)

  itens           ComboItem[]
  promocoes       PromocaoItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([empresaId, ativo, visivel, ordemCatalogo])
}

model ComboItem {
  id          String @id @default(uuid())

  comboId     String
  combo       Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  produtoId   String
  produto     Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  quantidade  Int @default(1)

  @@unique([comboId, produtoId])
  @@index([produtoId])
}

model Promocao {
  id          String @id @default(uuid())

  empresaId   String
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome        String

  dataInicio  DateTime
  dataFim     DateTime

  itens       PromocaoItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
}

model PromocaoItem {
  id          String @id @default(uuid())

  promocaoId  String
  promocao    Promocao @relation(fields: [promocaoId], references: [id], onDelete: Cascade)

  produtoId   String?
  produto     Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  comboId     String?
  combo       Combo? @relation(fields: [comboId], references: [id], onDelete: Cascade)

  preco       Decimal @db.Decimal(10,2)

  @@unique([promocaoId, produtoId])
  @@unique([promocaoId, comboId])

  @@index([produtoId])
  @@index([comboId])
}

model MovimentacaoEstoque {
  id            String @id @default(uuid())

  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  usuarioId     String
  usuario       Usuario @relation(fields: [usuarioId], references: [id])

  tipo          TipoMovimentacao

  quantidade    Int

  motivo        String?

  createdAt     DateTime @default(now())

  @@index([produtoId])
  @@index([usuarioId])
}

model AuditoriaAcesso {
  id             String   @id @default(uuid())

  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Nulo apenas na primeirissima entrada de cada empresa (REGISTRO / BACKFILL).
  statusAnterior StatusAcesso?
  statusNovo     StatusAcesso
  causa          CausaTransicaoAcesso

  createdAt      DateTime @default(now())

  // D-17: sem snapshot dos fatos de billing.

  @@index([empresaId, createdAt])
}