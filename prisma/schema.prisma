generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  // Fase 6 (TERM-02 / D-01): papel da PLATAFORMA, nao de um tenant. Entra por
  // migration PROPRIA (Pitfall 1 do RESEARCH): o Prisma Migrate roda cada
  // migration em transacao e o Postgres recusa USAR um valor de enum adicionado
  // dentro da mesma transacao. Qualquer DML que grave 'SUPERADMIN' vai numa
  // migration posterior — ou, como decidido, num script de seed em runtime.
  SUPERADMIN
}

enum ModoInterface {
  COMPLETO
  SIMPLES
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum StatusAcesso {
  TRIAL
  EM_DIA
  CARENCIA
  BLOQUEADO
  CANCELADO
  VITALICIO
}

// D-14: apenas os valores que existem HOJE. Novas causas entram por migration
// propria na fase em que passarem a existir.
// Fase 3 (GTW-03) exerceu esse ponto de extensao: WEBHOOK_PAGAMENTO entrou por
// migration propria, sem DML que use o valor na mesma transacao (Pitfall 7).
// Fase 5 (WRK-01) exerceu o mesmo ponto de extensao: WORKER_DIARIO entrou por
// migration propria (add_worker_diario_causa) e e a causa gravada pelo endpoint
// /api/cron/reconciliacao-diaria quando o worker diario reavalia os fatos de
// billing de uma empresa que nao fez nenhum request autenticado.
enum CausaTransicaoAcesso {
  REGISTRO
  BACKFILL
  AVALIACAO_SESSAO
  WEBHOOK_PAGAMENTO
  WORKER_DIARIO
}

model Empresa {
  id String @id @default(uuid())

  nome String
  slug String @unique

  logo      String?
  banner    String?
  descricao String?

  telefone  String?
  instagram String?

  primaryColor String @default("#18181b")
  accentColor  String @default("#f59e0b")

  modoInterface ModoInterface @default(COMPLETO)

  // Fatos de billing (BILL-01). Fonte da verdade do acesso. Instantes UTC ja
  // normalizados para a meia-noite de America/Sao_Paulo (D-01).
  acessoAte       DateTime?
  trialFim        DateTime?
  canceladoEm     DateTime?
  acessoVitalicio Boolean   @default(false)

  // Bookkeeping de auditoria (D-16). NAO e fonte da verdade e NENHUMA decisao
  // de acesso pode le-lo: quem decide e sempre avaliarAcesso() sobre os 4 fatos
  // acima. Existe so para detectar transicao sem uma segunda query por request.
  ultimoStatusAuditado StatusAcesso?

  // Identificadores externos do Asaas (GTW-04). NAO sao fatos de billing e
  // avaliarAcesso() nunca os le: nenhuma decisao de acesso depende deles.
  // Existem exclusivamente para resolver o empresaId de um evento de webhook
  // pelo mapa LOCAL, em vez de confiar no que o payload afirma (Pattern 5 /
  // C-08). A unicidade de asaasSubscriptionId e o que impede um "sub_..."
  // forjado de apontar para duas empresas.
  asaasCustomerId     String?
  asaasSubscriptionId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  usuarios         Usuario[]
  produtos         Produto[]
  combos           Combo[]
  promocoes        Promocao[]
  auditoriasAcesso AuditoriaAcesso[]
  checkoutsAsaas   CheckoutAsaas[]

  @@index([slug])
}

model Usuario {
  id String @id @default(uuid())

  nome      String
  email     String @unique
  senhaHash String

  role  UserRole @default(ADMIN)
  ativo Boolean  @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// BOOKKEEPING do gate de termos (TERM-04, Ponto de Extensao 2 do RESEARCH).
  /// Aponta para a ULTIMA versao de termo aceita por ESTE usuario.
  ///
  /// Existe para o caminho autenticado custar 1 query e nao 2: `revalidarConta`
  /// ja faz um `select` sobre Usuario, e uma coluna escalar entra nesse select
  /// de graca — enquanto a relacao aninhada `aceitesTermos` custaria uma query
  /// separada (o Prisma carrega relacoes com queries proprias; o preview
  /// `relationJoins` nao esta habilitado neste projeto). A fonte da verdade
  /// AUDITAVEL continua sendo AceiteTermo; esta coluna e uma projecao dela.
  ///
  /// MESMA FORMA de `Empresa.ultimoStatusAuditado`, REGRA OPOSTA — e aqui que um
  /// leitor futuro vai errar, entao esta escrito: `ultimoStatusAuditado` NAO
  /// pode ser lido para decidir acesso porque e uma DERIVACAO de 4 fatos que
  /// mudam sozinhos com a passagem do tempo (le-lo congelaria a derivacao);
  /// `termoAceitoId` E o fato — um evento discreto que so muda quando alguem
  /// aceita — e portanto PODE ser lido para decidir.
  ///
  /// O invariante que mantem isso correto e um ESCRITOR UNICO: so a transacao de
  /// aceite escreve nesta coluna, e sempre junto do INSERT em AceiteTermo, nunca
  /// isolada. NAO esta no allowlist de `usuarioService.create`/`update` (os DTOs
  /// montam `data` campo a campo) — nao e gravavel por HTTP em nenhum caminho.
  ///
  /// `SetNull` porque apagar a versao apontada nao pode apagar o usuario. Na
  /// pratica a versao nunca e apagada: AceiteTermo.termo usa `Restrict`.
  termoAceitoId String?
  termoAceito   TermoDeUso? @relation("UltimoAceite", fields: [termoAceitoId], references: [id], onDelete: SetNull)

  movimentacoes    MovimentacaoEstoque[]
  aceitesTermos    AceiteTermo[]
  termosPublicados TermoDeUso[]          @relation("TermosPublicados")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId])
}

model Produto {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  codigo String

  nome      String
  descricao String?

  categoria String @default("Geral")

  precoVarejo  Decimal @db.Decimal(10, 2)
  precoAtacado Decimal @db.Decimal(10, 2)

  estoque Int @default(0)

  fotoCapa String?

  ordemCatalogo Int @default(0)

  destaque Boolean @default(false)

  visivelCatalogo Boolean @default(true)
  ativo           Boolean @default(true)

  imagens       ProdutoImagem[]
  comboItens    ComboItem[]
  promocoes     PromocaoItem[]
  movimentacoes MovimentacaoEstoque[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, codigo])
  @@index([empresaId, ativo, visivelCatalogo, ordemCatalogo])
}

model ProdutoImagem {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  url String
  alt String?

  ordem Int @default(0)

  createdAt DateTime @default(now())

  @@index([produtoId])
}

model Combo {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome      String
  descricao String?

  preco Decimal @db.Decimal(10, 2)

  fotoCapa String?

  ordemCatalogo Int @default(0)

  destaque Boolean @default(false)

  visivel Boolean @default(true)
  ativo   Boolean @default(true)

  itens     ComboItem[]
  promocoes PromocaoItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, ativo, visivel, ordemCatalogo])
}

model ComboItem {
  id String @id @default(uuid())

  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  quantidade Int @default(1)

  @@unique([comboId, produtoId])
  @@index([produtoId])
}

model Promocao {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome String

  dataInicio DateTime
  dataFim    DateTime

  itens PromocaoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
}

model PromocaoItem {
  id String @id @default(uuid())

  promocaoId String
  promocao   Promocao @relation(fields: [promocaoId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   Produto? @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  comboId String?
  combo   Combo?  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  preco Decimal @db.Decimal(10, 2)

  @@unique([promocaoId, produtoId])
  @@unique([promocaoId, comboId])
  @@index([produtoId])
  @@index([comboId])
}

model MovimentacaoEstoque {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo TipoMovimentacao

  quantidade Int

  motivo String?

  createdAt DateTime @default(now())

  @@index([produtoId])
  @@index([usuarioId])
}

model AuditoriaAcesso {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Nulo apenas na primeirissima entrada de cada empresa (REGISTRO / BACKFILL).
  statusAnterior StatusAcesso?
  statusNovo     StatusAcesso
  causa          CausaTransicaoAcesso

  createdAt DateTime @default(now())

  // D-17: sem snapshot dos fatos de billing.

  @@index([empresaId, createdAt])
}

// Mapa checkout -> empresa (GTW-04, Pattern 5).
//
// D-07: a linha so nasce DEPOIS do 2xx do Asaas. Nunca existe checkout parcial
// no banco — se a chamada de criacao falhar, nao ha o que reconciliar depois.
//
// Pitfall 8: o payload de CHECKOUT_PAID traz checkout.id e checkout.customer,
// mas o objeto checkout.subscription carrega apenas a CONFIGURACAO da
// recorrencia (cycle, nextDueDate, endDate) — nao o id "sub_..." da assinatura
// criada. Por isso este mapa, gravado no momento da criacao do checkout, e a
// unica associacao certa entre um checkout e uma Empresa.
model CheckoutAsaas {
  id String @id @default(uuid())

  asaasCheckoutId String @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // String livre, deliberadamente NAO enum: ACTIVE/PAID/CANCELED/EXPIRED sao
  // vocabulario de terceiro e podem crescer sem aviso. Travar em enum
  // reproduziria o defeito do Pitfall 3 no nivel do schema — um status novo
  // passaria a derrubar a ingestao em vez de ser apenas desconhecido.
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, createdAt])
}

// Ledger append-only de eventos de webhook do Asaas (GTW-01/GTW-02/GTW-04).
model EventoWebhookAsaas {
  id String @id @default(uuid())

  // id do envelope do Asaas ("evt_<hash>&<seq>"), estavel entre reenvios do
  // mesmo evento. A constraint UNICA e a UNICA defesa correta contra entrega
  // concorrente: um findFirst antes do insert perde a corrida porque as duas
  // entregas passam pela leitura juntas. So o Postgres resolve isso
  // (GTW-02/GTW-04, Don't Hand-Roll). Duplicata => P2002 => 200 + no-op.
  eventoId String @unique

  evento String

  // Versao REDIGIDA do envelope, NUNCA o corpo bruto (GTW-01, Pitfall 9).
  // creditCard, customerData, cpfCnpj, pixTransaction, pixQrCodeId,
  // bankSlipUrl, invoiceUrl e transactionReceiptUrl sao descartados antes de
  // persistir. A redacao e implementada e testada no plano 03-05.
  payload Json

  // DELIBERADAMENTE sem @relation/FK, divergindo da convencao do projeto.
  // O ledger e append-only e precisa sobreviver a remocao de uma Empresa; um
  // onDelete: Cascade apagaria a trilha de auditoria financeira exatamente no
  // caso em que ela mais importa. Nulo tambem e estado legitimo: um evento
  // pode chegar antes de qualquer tenant ter sido resolvido (Pattern 5, passo
  // 4). Custo aceito e consciente (T-03-04): integridade referencial nao e
  // imposta pelo banco nesta coluna.
  empresaId String?

  // Interface de recuperacao: a fila de retrabalho e o conjunto de eventos com
  // processadoEm IS NULL, e o indice abaixo existe para ela.
  // A FASE 5 (WRK-01) NAO consome esta fila: a decisao D-06 daquela fase
  // escopou o worker diario para reavaliar apenas os 4 fatos de billing locais,
  // sem nenhuma chamada ao Asaas, e drenar a fila exige
  // webhookAsaasService.processar, que re-busca o pagamento no gateway.
  // A fila segue SEM dreno; quem a drenar sera uma fase futura.
  // "erro" precisa ser gravado, nao apenas logado: depois do 200 o Asaas nunca
  // reenvia, entao um evento que falhou em silencio some para sempre.
  processadoEm DateTime?
  erro         String?
  tentativas   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([processadoEm])
  @@index([evento, createdAt])
}

/// Documento legal versionado e IMUTAVEL (TERM-03 / D-07).
///
/// DELIBERADAMENTE SEM `empresaId`: e a segunda tabela GLOBAL do sistema (a
/// primeira excecao ao isolamento por tenant do C-07 e o worker diario). Os
/// termos sao da PLATAFORMA, nao de um tenant — dar-lhe `empresaId` permitiria a
/// um ADMIN publicar os proprios termos, que e exatamente o que D-06 proibe.
///
/// Nenhum metodo `update` ou `delete` existira em `termo.service.ts`, e isso e o
/// CONTRATO de TERM-03 / D-07, nao um esquecimento: publicar e INSERT, sempre. A
/// checagem equivalente em codigo seria contornavel pelo proximo
/// `prisma.termoDeUso.update` que alguem escrever; a FK `Restrict` de
/// AceiteTermo.termo e o Postgres recusando.
///
/// Consequencia aceita (A2 do RESEARCH): os aceites desaparecem junto com o
/// Usuario por `onDelete: Cascade` herdado de Empresa. Se um dever de retencao
/// de prova de consentimento aparecer, isso vira migration nova — nao ha captura
/// de IP/user-agent aqui por decisao consciente (A1).
model TermoDeUso {
  id String @id @default(uuid())

  /// Versao monotonica legivel por humano. `@unique` e o que impede duas
  /// publicacoes CONCORRENTES de nascerem com o mesmo numero: a segunda recebe
  /// P2002 e vira 409, em vez de duas "v3" diferentes no banco. Mesmo argumento
  /// ja escrito para `EventoWebhookAsaas.eventoId` — um `MAX(versao) + 1` lido e
  /// depois escrito perde a corrida entre dois requests simultaneos.
  versao Int @unique

  /// Texto PURO (D-05). Nunca Markdown, nunca HTML. Renderizado como no de texto
  /// React (escape automatico) com `white-space: pre-wrap`.
  conteudo String

  publicadoEm DateTime @default(now())

  /// Nulo APENAS na v1 semeada por migration, que nao tem autor humano por
  /// construcao. `SetNull` e nao `Cascade` porque apagar o usuario que publicou
  /// nao pode apagar o documento legal que centenas de pessoas aceitaram.
  publicadoPorId String?
  publicadoPor   Usuario? @relation("TermosPublicados", fields: [publicadoPorId], references: [id], onDelete: SetNull)

  aceites         AceiteTermo[]
  ultimoAceitePor Usuario[]     @relation("UltimoAceite")

  @@index([publicadoEm])
}

/// Fato append-only de aceite (TERM-03). Mesma natureza de `AuditoriaAcesso`:
/// escrito uma vez, nunca reescrito, nunca apagado pela aplicacao.
///
/// O escopo e o USUARIO, nao a empresa — PROJECT.md e literal ("status de
/// pagamento e por Empresa; aceite de termos e por Usuario"), e por isso NAO
/// existe `empresaId` aqui. Denormalizar o tenant confundiria os dois escopos
/// que a constraint do projeto manda manter separados.
model AceiteTermo {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// `onDelete: Restrict`: o banco RECUSA apagar uma versao de termo que alguem
  /// aceitou. E a imutabilidade imposta pelo Postgres, nao pela disciplina de
  /// quem le o codigo daqui a um ano. `Cascade` aqui permitiria apagar uma
  /// versao e evaporar todos os aceites dela — o oposto de TERM-03.
  termoId String
  termo   TermoDeUso @relation(fields: [termoId], references: [id], onDelete: Restrict)

  aceitoEm DateTime @default(now())

  /// A unicidade composta declarada abaixo (usuario + termo) torna o aceite
  /// IDEMPOTENTE: duplo clique, retry de rede e reenvio de formulario colidem em
  /// P2002, que o service trata como "ja aceitou" em vez de gravar duas linhas
  /// indistinguiveis. Um `findFirst` antes do `create` perderia a corrida entre
  /// dois requests concorrentes.
  ///
  /// Divergencia CONSCIENTE do padrao de `AuditoriaAcesso`, que e fato puro sem
  /// unique: a consequencia desejada aqui e um usuario NAO poder "reaceitar" a
  /// mesma versao. Se um dia for preciso registrar reaceites da mesma versao,
  /// esta constraint e o que precisa cair — e a decisao precisa ser explicita.
  @@unique([usuarioId, termoId])
  @@index([usuarioId, aceitoEm])
}
